<UserControl x:Class="StageManager.Controls.WindowPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             Focusable="False"
             Background="#01000000">
  <Grid Background="#01000000">
    <Grid x:Name="PreviewVisual"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>

      <!-- DWM paints the live window directly into this transparent rectangle. -->
      <Border x:Name="PreviewSurface"
              Background="Transparent"
              IsHitTestVisible="False" />

      <!-- The application badge is rendered by the separate transparent icon HWND. -->
      <Border x:Name="AppIconAnchor"
              Width="30" Height="30"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="-7,0,0,-7"
              Opacity="0"
              IsHitTestVisible="False" />
    </Grid>
  </Grid>
</UserControl>
